# Copy this file to ".env" (same folder, exact name) and fill it in. Restart the backend after any change.
# Primary provider: gemini | openai_compat | mock
LLM_PROVIDER=gemini

# --- Gemini (Google AI Studio free tier) ---
# One line, comma-separated. When one key runs out of quota the backend switches to the next automatically.
# Quotas are per Google Cloud project, so create each key in a different project.
GEMINI_API_KEYS=paste-key-1,paste-key-2,paste-key-3
# Model names change over time; set whichever Flash-class model your keys can use.
GEMINI_MODEL=gemini-2.5-flash

# --- Optional fallback (any OpenAI-compatible API, e.g. Groq or OpenRouter free models) ---
FALLBACK_BASE_URL=
FALLBACK_API_KEY=
FALLBACK_MODEL=

# How many chunks to process in parallel (keep low on free tiers)
CONCURRENCY=2
